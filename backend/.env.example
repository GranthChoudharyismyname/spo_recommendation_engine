# Required. Read server-side only and never sent to the browser.
GEMINI_API_KEY=

# Optional: extra keys, tried when one runs out of quota. Comma-separated.
# Free-tier quota is counted per model per *project*, so a second key from the SAME
# project shares the same exhausted allowance — use keys from different projects.
GEMINI_API_KEYS=

# The model tried first.
GEMINI_MODEL_NAME=gemini-3.6-flash

# Models tried when the primary is overloaded or out of quota, in order.
# Comma-separated. Leave empty to disable falling back at all.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# How long one model gets before the call moves on. A stalled model would otherwise
# hold up the whole evaluation without ever returning an error to react to.
GEMINI_TIMEOUT_SECONDS=45

# Optional overrides.
MAX_UPLOAD_BYTES=8388608
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paths. Both have working defaults; set them only if you move things.
# SCORING_DIR=./scoring
# KG_COMPANIES_PATH=../recruiter-kg/companies.seed.json
